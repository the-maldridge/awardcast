{% extends "@core/base.p2" %}

{% comment %}
  Award list.

  Slug is the column that matters in practice: it is what a CSV row has to match
  for a re-import to update rather than duplicate, so it leads the table and the
  presentation text follows.
{% endcomment %}

{% block title %}Awards · {{ siteTitle|default:"AwardCast" }}{% endblock %}

{% block content %}
<div class="box">
  <div class="level">
    <div class="level-left">
      <h1 class="title is-4 mb-0">Awards</h1>
    </div>
    <div class="level-right">
      <div class="buttons">
        <a class="button is-small" href="/award/add">Add an award</a>
        <a class="button is-small" href="/award/bulk-add">Import CSV</a>
      </div>
    </div>
  </div>

  <table class="table is-fullwidth is-striped is-hoverable">
    <thead>
      <tr>
        <th>Slug</th>
        <th>Title</th>
        <th>Subtitle</th>
        <th>Colors</th>
        <th class="has-text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for award in awards %}
      <tr>
        <td><code>{{ award.Slug }}</code></td>
        <td>{{ award.DispTitle }}</td>
        <td>{{ award.DispSub }}</td>
        <td>
          {% if award.Theme.Bg %}
          {% if award.Theme.BgTo %}
          <span class="tag color-swatch" style="display: inline-block; width: 2rem; height: 1rem; vertical-align: middle; border-radius: 3px; border: 1px solid #dbdbdb; background-color: {{ award.Theme.Bg }}; background-image: linear-gradient({{ award.Theme.BgDir }}, {{ award.Theme.Bg }}, {{ award.Theme.BgTo }});"></span>
          {% else %}
          <span class="tag color-swatch" style="display: inline-block; width: 2rem; height: 1rem; vertical-align: middle; border-radius: 3px; border: 1px solid #dbdbdb; background-color: {{ award.Theme.Bg }}; background-image: linear-gradient(to bottom, {{ award.Theme.Bg }} 50%, {{ award.Theme.Text }} 50%);"></span>
          {% endif %}
          {{ award.Theme.Name }}{% if not award.ColorThemeID %} <span class="has-text-grey">(default)</span>{% endif %}
          {% endif %}
        </td>
        <td class="has-text-right">
          <a class="button is-small" href="{{ award.ID }}/edit">Edit</a>
          <a class="button is-small is-light is-danger" href="{{ award.ID }}/delete">Delete</a>
        </td>
      </tr>
      {% empty %}
      <tr>
        <td colspan="5" class="has-text-grey">
          No awards yet.
          <a href="/award/bulk-add">Import a CSV</a>
          or <a href="/award/add">add one by hand</a>.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
