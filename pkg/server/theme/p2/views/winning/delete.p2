{% extends "@core/base.p2" %}

{% comment %}
  Delete a winning.

  The pairing goes away; the award and the recipient stay. A winning already on
  the projector stays on it until the board is cleared, which is what it always
  did: silently emptying a screen the room is watching is the worse failure.
{% endcomment %}

{% block title %}Delete winning · {{ siteTitle|default:"AwardCast" }}{% endblock %}

{% block content %}
<div class="columns is-centered">
  <div class="column is-two-thirds-tablet is-half-desktop">
    <div class="box">
      <h1 class="title is-4">Delete winning</h1>

      <div class="notification is-warning is-light">
        This cannot be undone. The award and the recipient both stay; only this pairing goes.
      </div>

      <p>
        <strong>{{ winning.Award.DispTitle }}</strong>
        {% if winning.Award.DispSub %}
        <span class="has-text-grey">&middot; {{ winning.Award.DispSub }}</span>
        {% endif %}
        <br>
        won by <strong>{{ winning.Recipient.Name }}</strong>.
      </p>

      <form method="post">
        {{ csrfInput }}
        <div class="field is-grouped">
          <div class="control">
            <button type="submit" class="button is-danger">Permanently delete</button>
          </div>
          <div class="control">
            <a class="button is-light" href="/admin/winnings/">Cancel</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
