{% extends "@core/base.p2" %}

{% comment %}
  Delete a recipient.

  Named twice over in the prompt: the confirmation has to say who is about to
  disappear, and it has to say that their winnings go with them.
{% endcomment %}

{% block title %}Delete recipient · {{ siteTitle|default:"AwardCast" }}{% endblock %}

{% block content %}
<div class="columns is-centered">
  <div class="column is-two-thirds-tablet is-half-desktop">
    <div class="box">
      <h1 class="title is-4">Delete recipient</h1>

      <div class="notification is-warning is-light">
        This cannot be undone. Any winning that named this recipient is deleted with them.
      </div>

      <p>
        Recipient: <strong>{{ recipient.Name }}</strong>
      </p>

      <form method="post">
        {{ csrfInput }}
        <div class="field is-grouped">
          <div class="control">
            <button type="submit" class="button is-danger">Permanently delete</button>
          </div>
          <div class="control">
            <a class="button is-light" href="/admin/recipient/">Cancel</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
