{% extends "../../base.p2" %}

{% block title %}Recipient List{% endblock %}

{% block content %}
<div class="flex-container flex-row flex-center">
  <div class="flex-item flex-max foreground box">
    <table>
      <tr>
        <th>Name</th>
        <th>Actions</th>
      </tr>
      {% for recipient in recipients %}
      <tr>
        <td>{{ recipient.Name }}</td>
        <td>
          <div class="flex-container flex-row">
            <a class="flex-item button" href="{{ recipient.ID }}/edit">Edit</a>
            <a class="flex-item button" href="{{ recipient.ID }}/delete">Delete</a>
          </div>
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
{% endblock %}
