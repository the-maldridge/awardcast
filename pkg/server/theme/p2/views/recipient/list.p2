{% extends "@core/base.p2" %}

{% comment %}
  Recipient list.

  One column: a recipient is a name. The value of the page is seeing the whole
  roster at once and reaching edit or delete for one of them.
{% endcomment %}

{% block title %}Recipients · {{ siteTitle|default:"AwardCast" }}{% endblock %}

{% block content %}
<div class="box">
  <div class="level">
    <div class="level-left">
      <h1 class="title is-4 mb-0">Recipients</h1>
    </div>
    <div class="level-right">
      <div class="buttons">
        <a class="button is-small" href="/admin/recipient/add">Add a recipient</a>
        <a class="button is-small" href="/admin/recipient/bulk-add">Import CSV</a>
      </div>
    </div>
  </div>

  <table class="table is-fullwidth is-striped is-hoverable">
    <thead>
      <tr>
        <th>Name</th>
        <th class="has-text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for recipient in recipients %}
      <tr>
        <td>{{ recipient.Name }}</td>
        <td class="has-text-right">
          <a class="button is-small" href="{{ recipient.ID }}/edit">Edit</a>
          <a class="button is-small is-light is-danger" href="{{ recipient.ID }}/delete">Delete</a>
        </td>
      </tr>
      {% empty %}
      <tr>
        <td colspan="2" class="has-text-grey">
          No recipients yet.
          <a href="/admin/recipient/bulk-add">Import a CSV</a>
          or <a href="/admin/recipient/add">add one by hand</a>.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
