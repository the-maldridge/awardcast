{% comment %}
  The presenter screen.

  Deliberately not a theme page: the shared layout would put a navbar, a footer,
  and a sign-out button on the thing the room is looking at. This document is a
  blank background, two sizes of type, and the script that moves them, and it is
  styled by its own stylesheet for exactly that reason.

  The socket URL follows the page's own protocol rather than hard-wiring ws://.
  A page served over https asking for ws:// is blocked outright by the browser,
  which is the failure that appears only on the day somebody puts this behind
  TLS, which is the day nobody can afford to debug it.
{% endcomment %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AwardCast</title>
    <link rel="stylesheet" href="/static/awards/present.css">
    <script src="/static/awards/mustache.js"></script>
    <script src="/static/awards/reconnecting-websocket.js"></script>
  </head>
  <body class="award-bg">
    <div class="grid-center">
      <div id="award-container"></div>
    </div>

    {% verbatim %}
    <script id="tpl-award" type="x-tmpl-mustache">
      <div id="award" class="center">
        <h1>{{ d.Award.DispTitle }}</h1>
        <h2>{{ d.Award.DispSub }}</h2>
      </div>
      <div id="winner" class="center award-winner-stage1">
        <h1>{{ d.Recipient.Name }}</h1>
      </div>
    </script>
    {% endverbatim %}

    <script>
      // The three numbers are the wire format shared with the server, and they
      // arrive from it rather than being kept in sync by hand: msgTypeLoad,
      // msgTypeReveal, and msgTypeClear in winning.go are rendered into this
      // page, so there is one definition to change and the test suite fails
      // if the page ever stops carrying it.
      const MsgTypeLoad = {{ msgTypeLoad }};
      const MsgTypeReveal = {{ msgTypeReveal }};
      const MsgTypeClear = {{ msgTypeClear }};

      // How much name to allow before type size gives way. Two lines is the
      // height the room can follow at a glance; below 35% of the size the
      // stylesheet asked for, the name is a texture rather than a name, so the
      // clip takes the spare line instead.
      const maxNameLines = 2;
      const minNameFloor = 0.35;

      const awardTemplate = document.getElementById('tpl-award').innerHTML;
      const container = document.getElementById('award-container');

      // Colors travel with the award as a ColorTheme and are applied as
      // custom properties on the body, which present.css reads behind
      // fallbacks matching the pre-theme screen. These constants restate the
      // server's validation at paint time: this data arrives over the public
      // socket path's JSON, and a property value becomes a style, so anything
      // that is not a hash-and-six-hex-digit color or one of the eight
      // direction words is dropped rather than trusted.
      const HEX_COLOR = /^#[0-9a-f]{6}$/;
      const GRADIENT_DIRS = ['to top', 'to top right', 'to right', 'to bottom right',
        'to bottom', 'to bottom left', 'to left', 'to top left'];
      const THEME_PROPS = ['--award-bg', '--award-bg-from', '--award-bg-to',
        '--award-bg-dir', '--award-text', '--award-winner'];

      // applyTheme paints one award's colors, and clears every property
      // before setting any: without the clear, the previous award's gradient
      // would keep bleeding its second stop into an award that asked for a
      // solid background. Null paints the fallback screen.
      function applyTheme(theme) {
        for (const prop of THEME_PROPS) { document.body.style.removeProperty(prop); }
        if (!theme) { return; }

        const hex = function (v) {
          return (typeof v === 'string' && HEX_COLOR.test(v)) ? v : null;
        };

        const bg = hex(theme.Bg);
        if (!bg) { return; }
        document.body.style.setProperty('--award-bg', bg);

        const text = hex(theme.Text);
        if (text) { document.body.style.setProperty('--award-text', text); }
        const winner = hex(theme.Winner);
        if (winner) { document.body.style.setProperty('--award-winner', winner); }

        const to = hex(theme.BgTo);
        if (to) {
          const dir = GRADIENT_DIRS.indexOf(theme.BgDir) >= 0 ? theme.BgDir : 'to bottom';
          document.body.style.setProperty('--award-bg-from', bg);
          document.body.style.setProperty('--award-bg-to', to);
          document.body.style.setProperty('--award-bg-dir', dir);
        }
      }

      const socketURL = (location.protocol === 'https:' ? 'wss://' : 'ws://')
        + document.location.host + '/public/e';
      const ws = new ReconnectingWebSocket(socketURL);

      async function paintAward(winID) {
        try {
          const resp = await fetch('/public/winnings/' + winID + '/data');
          if (!resp.ok) {
            console.error('Could not load winning ' + winID + ': HTTP ' + resp.status);
            return;
          }
          const award = await resp.json();

          // Fade out, swap, fade in. Removing both classes and forcing a reflow
          // is what lets the second transition actually run; adding only the
          // "shown" class onto an element that never dropped "hidden" leaves the
          // element stuck at whichever rule the stylesheet happened to reach last.
          container.classList.remove('award-container-shown', 'award-container-hidden');
          void container.offsetWidth;
          container.classList.add('award-container-hidden');
          container.innerHTML = Mustache.render(awardTemplate, { 'd': award });
          applyTheme(award.Award ? award.Award.ColorTheme : null);
          requestAnimationFrame(function () {
            container.classList.add('award-container-shown');
          });
        } catch (error) {
          console.error(error.message);
        }
      }

      function revealWinner() {
        const awardDiv = document.getElementById('award');
        const winDiv = document.getElementById('winner');
        if (!awardDiv || !winDiv) { return; }
        const name = winDiv.querySelector('h1');
        if (!name) { return; }

        // Revealing twice is a second click, not a cue to knock the block back to
        // zero and run the whole thing again. A new award arrives as fresh markup,
        // so this only ever blocks the repeat.
        if (winDiv.classList.contains('award-winner-stage2')) { return; }

        // Both the fit and the height read need the block unclipped, and both
        // happen before anything is visible: stage1 holds the name at opacity
        // zero, so lifting the clip to measure cannot show. Sizing has to come
        // first either way, because the height this block reaches is the
        // distance the title travels, and a name that changed size afterwards
        // would change the animation part way through it.
        winDiv.style.maxHeight = 'none';
        fitName(name);
        const grown = winDiv.offsetHeight;
        winDiv.style.maxHeight = '0px';
        // Commit the starting height. Without this the browser sees the zero and
        // the target in one pass and jumps straight to the end.
        void winDiv.offsetHeight;

        awardDiv.classList.add('award-shrink');
        winDiv.classList.add('award-winner-stage2');
        winDiv.style.maxHeight = grown + 'px';

        // The name appears once the title has stopped moving: its two shrinking
        // transitions and the growth of the block underneath it, which is what
        // carries the title upward. Nothing here is timed against a hand-written
        // number, so retiming the reveal is a stylesheet edit and not a race.
        Promise.all([
          settled(awardDiv.querySelector('h1'), 'font-size'),
          settled(awardDiv.querySelector('h2'), 'font-size'),
          settled(winDiv, 'max-height')
        ]).then(function () {
          winDiv.classList.add('award-winner-stage3');
        });
      }

      // fitName reduces the name's font size until it occupies no more than
      // maxNameLines, never below minNameFloor of the size the stylesheet asked
      // for. That ceiling is what keeps a short name rendered exactly as
      // designed: only a name long enough to wrap is touched at all.
      function fitName(name) {
        name.style.fontSize = '';
        const base = parseFloat(getComputedStyle(name).fontSize);

        // The common case is a name that already fits, and it is left exactly as
        // the stylesheet sized it.
        if (countLines(name) <= maxNameLines) { return; }

        const floor = base * minNameFloor;

        // The search keeps a size known to fit and one known not to. Should even
        // the floor overflow, monotonicity means no larger size fits either, so the
        // result is the floor and the spare line is clipped by the block, which is a
        // better failure than type nobody can read from the back of the room.
        let fits = floor;
        let tooBig = base;
        while (tooBig - fits > 1) {
          const mid = (fits + tooBig) / 2;
          name.style.fontSize = mid + 'px';
          if (countLines(name) > maxNameLines) {
            tooBig = mid;
          } else {
            fits = mid;
          }
        }
        name.style.fontSize = fits + 'px';
      }

      // countLines reports how many line boxes the element's text occupies. A
      // range's client rects are emitted per line box, so the distinct vertical
      // positions are the line count. Counting laid-out lines rather than
      // measuring the string is the only version that is right: the wrap is
      // decided by the font, the letter spacing, and the browser's own metrics,
      // which differ between the laptop and the projector.
      function countLines(el) {
        const range = document.createRange();
        range.selectNodeContents(el);
        const tops = new Set();
        for (const rect of range.getClientRects()) {
          tops.add(Math.round(rect.top));
        }
        return Math.max(tops.size, 1);
      }

      // settled resolves once prop has finished transitioning on el, or once the
      // duration the stylesheet declares for it has elapsed, whichever comes
      // first. The fallback is load bearing: if the class change starts no
      // transition because el already holds its end value, transitionend never
      // fires, and without it the name would stay invisible forever.
      function settled(el, prop) {
        return new Promise(function (resolve) {
          const style = getComputedStyle(el);
          // The transition lists are positional, so the entry for prop is at the
          // same index in every one of them. #winner asks for two transitions, so
          // taking the first entry of each list would read the wrong duration.
          const at = listed(style.transitionProperty).indexOf(prop);

          function listed(value) {
            return value.split(/,\s*/);
          }

          function secondsAt(value) {
            if (at < 0) { return 0; }
            return parseFloat(listed(value)[at]) || 0;
          }

          function finish() {
            el.removeEventListener('transitionend', onEnd);
            clearTimeout(timer);
            resolve();
          }

          function onEnd(ev) {
            if (ev.target === el && ev.propertyName === prop) { finish(); }
          }

          el.addEventListener('transitionend', onEnd);
          const wait = secondsAt(style.transitionDuration) + secondsAt(style.transitionDelay);
          const timer = setTimeout(finish, wait * 1000 + 100);
        });
      }

      // A window resize moves the wrap point, so a name sized for one width can
      // overflow another. Coalesced to a frame because a drag fires one of these
      // per repaint and a fit is a handful of layout reads.
      let refitQueued = false;
      window.addEventListener('resize', function () {
        if (refitQueued) { return; }
        refitQueued = true;
        requestAnimationFrame(function () {
          refitQueued = false;
          const winDiv = document.getElementById('winner');
          const name = winDiv && winDiv.querySelector('h1');
          if (!name) { return; }
          const growing = winDiv.classList.contains('award-winner-stage2');
          // Relayout without replaying the reveal: the height is being corrected
          // for a new width, not animated to.
          winDiv.style.transition = 'none';
          winDiv.style.maxHeight = 'none';
          fitName(name);
          winDiv.style.maxHeight = (growing ? winDiv.offsetHeight : 0) + 'px';
          void winDiv.offsetHeight;
          winDiv.style.transition = '';
        });
      });

      function clearBoard() {
        container.classList.remove('award-container-shown');
        setTimeout(function () { container.innerHTML = ''; }, 2000);
      }

      ws.addEventListener('message', function (event) {
        try {
          const msg = JSON.parse(event.data);

          switch (msg.Type) {
            case MsgTypeLoad:
              paintAward(msg.WinID);
              break;
            case MsgTypeReveal:
              revealWinner();
              break;
            case MsgTypeClear:
              clearBoard();
              break;
          }
        } catch (error) {
          console.error('Error parsing JSON:', error);
          console.log('Received data (unparsed):', event.data);
        }
      });
    </script>
  </body>
</html>
